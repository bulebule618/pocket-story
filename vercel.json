{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": "dist",
  "functions": {"api/entry.js": {"maxDuration": 30}},
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/entry?route=:path*"},
    {"source": "/studio/:path*", "destination": "/index.html"},
    {"source": "/login", "destination": "/index.html"},
    {"source": "/read/:path*", "destination": "/index.html"}
  ],
  "headers": [{"source": "/(.*)", "headers": [
    {"key": "X-Content-Type-Options", "value": "nosniff"},
    {"key": "Referrer-Policy", "value": "same-origin"},
    {"key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'"}
  ]}]
}
