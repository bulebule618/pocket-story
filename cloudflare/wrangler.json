{
  "$schema": "../work/cloudflare-cli/node_modules/wrangler/config-schema.json",
  "name": "pocket-story",
  "account_id": "6c6762fa6940d3908311f9639b395a65",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pocket-story-db",
    "database_id": "c4456856-e8b8-41d8-a01b-ee290fde557a",
    "migrations_dir": "migrations"
  }],
  "vars": {"FREE_ONLY":"true", "SERVICE_ENABLED":"true"},
  "observability": {"enabled":false}
}
